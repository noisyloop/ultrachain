# Pin an agent release, e.g. from https://github.com/hyperlane-xyz/hyperlane-monorepo/releases
AGENT_IMAGE_TAG=

# Validator checkpoint-signing key: a secp256k1 private key (0x + 64 hex).
# Generate one with e.g. `cast wallet new`. Keep it offline-backed-up.
VALIDATOR_KEY=
# Solana-style keypairs as hex, from scripts/keypair-to-hex.py <keypair.json>.
VALIDATOR_ULTRACHAIN_SIGNER_KEY=
RELAYER_ULTRACHAIN_KEY=
RELAYER_SOLANA_KEY=

VALIDATOR_S3_BUCKET=
VALIDATOR_S3_REGION=
VALIDATOR_AWS_ACCESS_KEY_ID=
VALIDATOR_AWS_SECRET_ACCESS_KEY=
ALERT_WEBHOOK_URL=
